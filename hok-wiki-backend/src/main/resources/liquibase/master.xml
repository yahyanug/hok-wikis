<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
		xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

	<preConditions onFail="HALT" onError="HALT">
		<dbms type="postgresql"/>
	</preConditions>

	<!-- Superseded catalog changelogs remain on disk for history; they reference retired UUID datasets. -->
	<include file="changelog/identity/005-create-identity-tables.xml" relativeToChangelogFile="true"/>
	<include file="changelog/catalog/008-current-catalog-schema.xml" relativeToChangelogFile="true"/>
	<include file="changelog/hero/009-align-hero-classification-schema.xml" relativeToChangelogFile="true"/>
	<!-- Datasets are loaded only after the current schema and any legacy relations have been aligned. -->
	<include file="changelog/catalog/007-load-enum-datasets.xml" relativeToChangelogFile="true"/>
</databaseChangeLog>
