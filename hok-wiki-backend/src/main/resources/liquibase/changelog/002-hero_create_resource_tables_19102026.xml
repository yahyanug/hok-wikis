<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
		logicalFilePath="liquibase/changelog/catalog/002-create-resource-tables.xml"
		xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

	<changeSet id="catalog-002-create-resource-tables" author="dev-yahya">
		<renameTable oldTableName="heroes" newTableName="hero"/>

		<createTable tableName="item">
			<column name="id" type="uuid">
				<constraints nullable="false" primaryKey="true" primaryKeyName="pk_item"/>
			</column>
			<column name="name" type="varchar(255)">
				<constraints nullable="false"/>
			</column>
			<column name="slug" type="varchar(128)">
				<constraints nullable="false" unique="true" uniqueConstraintName="uk_item_slug"/>
			</column>
			<column name="price_gold" type="integer">
				<constraints nullable="false"/>
			</column>
			<column name="image_url" type="text"/>
		</createTable>
		<createIndex tableName="item" indexName="idx_item_name_slug">
			<column name="name"/>
			<column name="slug"/>
		</createIndex>

		<createTable tableName="arcana">
			<column name="id" type="uuid">
				<constraints nullable="false" primaryKey="true" primaryKeyName="pk_arcana"/>
			</column>
			<column name="name" type="varchar(255)">
				<constraints nullable="false"/>
			</column>
			<column name="slug" type="varchar(128)">
				<constraints nullable="false" unique="true" uniqueConstraintName="uk_arcana_slug"/>
			</column>
			<column name="color" type="varchar(16)">
				<constraints nullable="false"/>
			</column>
			<column name="level" type="integer">
				<constraints nullable="false"/>
			</column>
			<column name="stats" type="text">
				<constraints nullable="false"/>
			</column>
			<column name="image_url" type="text"/>
		</createTable>
		<createIndex tableName="arcana" indexName="idx_arcana_name_slug">
			<column name="name"/>
			<column name="slug"/>
		</createIndex>

		<createTable tableName="spells">
			<column name="id" type="uuid">
				<constraints nullable="false" primaryKey="true" primaryKeyName="pk_spells"/>
			</column>
			<column name="name" type="varchar(255)">
				<constraints nullable="false"/>
			</column>
			<column name="slug" type="varchar(128)">
				<constraints nullable="false" unique="true" uniqueConstraintName="uk_spells_slug"/>
			</column>
			<column name="cooldown_seconds" type="integer">
				<constraints nullable="false"/>
			</column>
			<column name="description" type="text">
				<constraints nullable="false"/>
			</column>
			<column name="image_url" type="text"/>
		</createTable>
		<createIndex tableName="spells" indexName="idx_spells_name_slug">
			<column name="name"/>
			<column name="slug"/>
		</createIndex>

		<createTable tableName="lanes">
			<column name="id" type="uuid">
				<constraints nullable="false" primaryKey="true" primaryKeyName="pk_lanes"/>
			</column>
			<column name="name" type="varchar(255)">
				<constraints nullable="false"/>
			</column>
			<column name="slug" type="varchar(128)">
				<constraints nullable="false" unique="true" uniqueConstraintName="uk_lanes_slug"/>
			</column>
			<column name="image_url" type="text"/>
		</createTable>
		<createIndex tableName="lanes" indexName="idx_lanes_name_slug">
			<column name="name"/>
			<column name="slug"/>
		</createIndex>

		<createTable tableName="roles">
			<column name="id" type="uuid">
				<constraints nullable="false" primaryKey="true" primaryKeyName="pk_roles"/>
			</column>
			<column name="name" type="varchar(255)">
				<constraints nullable="false"/>
			</column>
			<column name="slug" type="varchar(128)">
				<constraints nullable="false" unique="true" uniqueConstraintName="uk_roles_slug"/>
			</column>
			<column name="image_url" type="text"/>
		</createTable>
		<createIndex tableName="roles" indexName="idx_roles_name_slug">
			<column name="name"/>
			<column name="slug"/>
		</createIndex>

		<loadData tableName="roles" file="../dataset/roles.csv" relativeToChangelogFile="true"
				separator=";" quotchar="&quot;" encoding="UTF-8">
			<column header="id" name="id" type="UUID"/>
			<column header="name" name="name" type="STRING"/>
			<column header="slug" name="slug" type="STRING"/>
			<column header="image_url" name="image_url" type="STRING"/>
		</loadData>

		<loadData tableName="lanes" file="../dataset/lanes.csv" relativeToChangelogFile="true"
				separator=";" quotchar="&quot;" encoding="UTF-8">
			<column header="id" name="id" type="UUID"/>
			<column header="name" name="name" type="STRING"/>
			<column header="slug" name="slug" type="STRING"/>
			<column header="image_url" name="image_url" type="STRING"/>
		</loadData>

		<rollback>
			<dropTable tableName="roles"/>
			<dropTable tableName="lanes"/>
			<dropTable tableName="spells"/>
			<dropTable tableName="arcana"/>
			<dropTable tableName="item"/>
			<renameTable oldTableName="hero" newTableName="heroes"/>
		</rollback>
	</changeSet>
</databaseChangeLog>
