<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
		xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

	<changeSet id="catalog-007-load-enum-datasets" author="dev-yahya" contextFilter="@dataset">
		<preConditions onFail="MARK_RAN" onError="HALT">
			<not>
				<changeSetExecuted id="catalog-004-load-datasets" author="dev-yahya"
						changeLogFile="liquibase/changelog/catalog/004-load-datasets.xml"/>
			</not>
		</preConditions>

		<sql splitStatements="false"><![CDATA[
			DO $$
			BEGIN
				IF EXISTS (SELECT 1 FROM hero) OR EXISTS (SELECT 1 FROM item)
						OR EXISTS (SELECT 1 FROM arcana) OR EXISTS (SELECT 1 FROM spells) THEN
					RAISE EXCEPTION 'Initial datasets require empty hero, item, arcana, and spells tables.';
				END IF;
			END $$;
		]]></sql>

		<loadData tableName="hero" file="../../dataset/hero.csv" relativeToChangelogFile="true"
				separator=";" quotchar="&quot;" encoding="UTF-8">
			<column header="id" name="id" type="UUID"/>
			<column header="name" name="name" type="STRING"/>
			<column header="slug" name="slug" type="STRING"/>
			<column header="image_url" name="image_url" type="STRING"/>
		</loadData>

		<loadData tableName="item" file="../../dataset/items.csv" relativeToChangelogFile="true"
				separator=";" quotchar="&quot;" encoding="UTF-8">
			<column header="id" name="id" type="UUID"/>
			<column header="name" name="name" type="STRING"/>
			<column header="slug" name="slug" type="STRING"/>
			<column header="price_gold" name="price_gold" type="NUMERIC"/>
			<column header="image_url" name="image_url" type="STRING"/>
		</loadData>

		<loadData tableName="arcana" file="../../dataset/arcana.csv" relativeToChangelogFile="true"
				separator=";" quotchar="&quot;" encoding="UTF-8">
			<column header="id" name="id" type="UUID"/>
			<column header="name" name="name" type="STRING"/>
			<column header="slug" name="slug" type="STRING"/>
			<column header="color" name="color" type="STRING"/>
			<column header="level" name="level" type="NUMERIC"/>
			<column header="stats" name="stats" type="STRING"/>
			<column header="image_url" name="image_url" type="STRING"/>
		</loadData>

		<loadData tableName="spells" file="../../dataset/spells.csv" relativeToChangelogFile="true"
				separator=";" quotchar="&quot;" encoding="UTF-8">
			<column header="id" name="id" type="UUID"/>
			<column header="name" name="name" type="STRING"/>
			<column header="slug" name="slug" type="STRING"/>
			<column header="cooldown_seconds" name="cooldown_seconds" type="NUMERIC"/>
			<column header="description" name="description" type="STRING"/>
			<column header="image_url" name="image_url" type="STRING"/>
		</loadData>

		<loadData tableName="hero_roles" file="../../dataset/hero_roles_enum.csv" relativeToChangelogFile="true"
				separator=";" quotchar="&quot;" encoding="UTF-8">
			<column header="hero_id" name="hero_id" type="UUID"/>
			<column header="role" name="role" type="STRING"/>
		</loadData>

		<loadData tableName="hero_lanes" file="../../dataset/hero_lanes_enum.csv" relativeToChangelogFile="true"
				separator=";" quotchar="&quot;" encoding="UTF-8">
			<column header="hero_id" name="hero_id" type="UUID"/>
			<column header="lane" name="lane" type="STRING"/>
		</loadData>
	</changeSet>
</databaseChangeLog>
