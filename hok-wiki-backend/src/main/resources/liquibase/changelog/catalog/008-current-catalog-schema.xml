<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
		xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

	<!-- CONTINUE keeps skipped operations out of rollback history for pre-existing tables. -->
	<changeSet id="catalog-008-rename-heroes" author="dev-yahya">
		<preConditions onFail="CONTINUE" onError="HALT">
			<tableExists tableName="heroes"/>
			<not>
				<tableExists tableName="hero"/>
			</not>
		</preConditions>
		<renameTable oldTableName="heroes" newTableName="hero"/>
		<rollback>
			<renameTable oldTableName="hero" newTableName="heroes"/>
		</rollback>
	</changeSet>

	<changeSet id="catalog-008-create-hero" author="dev-yahya">
		<preConditions onFail="CONTINUE" onError="HALT">
			<not>
				<tableExists tableName="hero"/>
			</not>
		</preConditions>
		<createTable tableName="hero">
			<column name="id" type="uuid">
				<constraints nullable="false" primaryKey="true" primaryKeyName="pk_hero"/>
			</column>
			<column name="name" type="varchar(255)">
				<constraints nullable="false"/>
			</column>
			<column name="slug" type="varchar(128)">
				<constraints nullable="false" unique="true" uniqueConstraintName="uk_hero_slug"/>
			</column>
			<column name="image_url" type="text"/>
		</createTable>
		<createIndex tableName="hero" indexName="idx_hero_name_slug">
			<column name="name"/>
			<column name="slug"/>
		</createIndex>
		<rollback>
			<dropTable tableName="hero"/>
		</rollback>
	</changeSet>

	<changeSet id="catalog-008-create-item" author="dev-yahya">
		<preConditions onFail="CONTINUE" onError="HALT">
			<not>
				<tableExists tableName="item"/>
			</not>
		</preConditions>
		<createTable tableName="item">
			<column name="id" type="uuid">
				<constraints nullable="false" primaryKey="true" primaryKeyName="pk_item"/>
			</column>
			<column name="name" type="varchar(255)">
				<constraints nullable="false"/>
			</column>
			<column name="slug" type="varchar(128)">
				<constraints nullable="false" unique="true" uniqueConstraintName="uk_item_slug"/>
			</column>
			<column name="price_gold" type="integer">
				<constraints nullable="false"/>
			</column>
			<column name="image_url" type="text"/>
		</createTable>
		<createIndex tableName="item" indexName="idx_item_name_slug">
			<column name="name"/>
			<column name="slug"/>
		</createIndex>
		<rollback>
			<dropTable tableName="item"/>
		</rollback>
	</changeSet>

	<changeSet id="catalog-008-create-arcana" author="dev-yahya">
		<preConditions onFail="CONTINUE" onError="HALT">
			<not>
				<tableExists tableName="arcana"/>
			</not>
		</preConditions>
		<createTable tableName="arcana">
			<column name="id" type="uuid">
				<constraints nullable="false" primaryKey="true" primaryKeyName="pk_arcana"/>
			</column>
			<column name="name" type="varchar(255)">
				<constraints nullable="false"/>
			</column>
			<column name="slug" type="varchar(128)">
				<constraints nullable="false" unique="true" uniqueConstraintName="uk_arcana_slug"/>
			</column>
			<column name="color" type="varchar(16)">
				<constraints nullable="false"/>
			</column>
			<column name="level" type="integer">
				<constraints nullable="false"/>
			</column>
			<column name="stats" type="text">
				<constraints nullable="false"/>
			</column>
			<column name="image_url" type="text"/>
		</createTable>
		<createIndex tableName="arcana" indexName="idx_arcana_name_slug">
			<column name="name"/>
			<column name="slug"/>
		</createIndex>
		<rollback>
			<dropTable tableName="arcana"/>
		</rollback>
	</changeSet>

	<changeSet id="catalog-008-create-spells" author="dev-yahya">
		<preConditions onFail="CONTINUE" onError="HALT">
			<not>
				<tableExists tableName="spells"/>
			</not>
		</preConditions>
		<createTable tableName="spells">
			<column name="id" type="uuid">
				<constraints nullable="false" primaryKey="true" primaryKeyName="pk_spells"/>
			</column>
			<column name="name" type="varchar(255)">
				<constraints nullable="false"/>
			</column>
			<column name="slug" type="varchar(128)">
				<constraints nullable="false" unique="true" uniqueConstraintName="uk_spells_slug"/>
			</column>
			<column name="cooldown_seconds" type="integer">
				<constraints nullable="false"/>
			</column>
			<column name="description" type="text">
				<constraints nullable="false"/>
			</column>
			<column name="image_url" type="text"/>
		</createTable>
		<createIndex tableName="spells" indexName="idx_spells_name_slug">
			<column name="name"/>
			<column name="slug"/>
		</createIndex>
		<rollback>
			<dropTable tableName="spells"/>
		</rollback>
	</changeSet>

	<changeSet id="catalog-008-create-hero-roles" author="dev-yahya">
		<preConditions onFail="CONTINUE" onError="HALT">
			<not>
				<tableExists tableName="hero_roles"/>
			</not>
		</preConditions>
		<createTable tableName="hero_roles">
			<column name="hero_id" type="uuid">
				<constraints nullable="false"/>
			</column>
			<column name="role" type="varchar(32)">
				<constraints nullable="false"/>
			</column>
		</createTable>
		<addPrimaryKey tableName="hero_roles" columnNames="hero_id,role" constraintName="pk_hero_roles"/>
		<addForeignKeyConstraint baseTableName="hero_roles" baseColumnNames="hero_id"
				referencedTableName="hero" referencedColumnNames="id"
				constraintName="fk_hero_roles_hero" onDelete="CASCADE"/>
		<rollback>
			<dropTable tableName="hero_roles"/>
		</rollback>
	</changeSet>

	<changeSet id="catalog-008-create-hero-lanes" author="dev-yahya">
		<preConditions onFail="CONTINUE" onError="HALT">
			<not>
				<tableExists tableName="hero_lanes"/>
			</not>
		</preConditions>
		<createTable tableName="hero_lanes">
			<column name="hero_id" type="uuid">
				<constraints nullable="false"/>
			</column>
			<column name="lane" type="varchar(32)">
				<constraints nullable="false"/>
			</column>
		</createTable>
		<addPrimaryKey tableName="hero_lanes" columnNames="hero_id,lane" constraintName="pk_hero_lanes"/>
		<addForeignKeyConstraint baseTableName="hero_lanes" baseColumnNames="hero_id"
				referencedTableName="hero" referencedColumnNames="id"
				constraintName="fk_hero_lanes_hero" onDelete="CASCADE"/>
		<rollback>
			<dropTable tableName="hero_lanes"/>
		</rollback>
	</changeSet>
</databaseChangeLog>
