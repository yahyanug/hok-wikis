<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="identity-003-create-identity-tables" author="dev-yahya">
        <createTable tableName="user_accounts">
            <column name="id" type="uuid">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user_accounts"/>
            </column>
            <column name="full_name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="varchar(254)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_user_accounts_email"/>
            </column>
            <column name="phone_number" type="varchar(16)">
                <constraints unique="true" uniqueConstraintName="uk_user_accounts_phone_number"/>
            </column>
            <column name="password_hash" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="user_type" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="failed_login_attempts" type="integer" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="login_blocked_until" type="timestamptz"/>
            <column name="created_date" type="timestamptz" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(100)" defaultValue="sys-admin">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_date" type="timestamptz" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="last_modified_by" type="varchar(100)"/>
        </createTable>
        <sql>
            ALTER TABLE user_accounts ADD CONSTRAINT chk_user_accounts_user_type
                CHECK (user_type IN ('SUPER_USER', 'ADMIN', 'USER'));
            ALTER TABLE user_accounts ADD CONSTRAINT chk_user_accounts_failed_login_attempts
                CHECK (failed_login_attempts >= 0);
        </sql>

        <createTable tableName="user_tokens">
            <column name="id" type="uuid">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user_tokens"/>
            </column>
            <column name="account_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="refresh_token_hash" type="varchar(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_user_tokens_refresh_token_hash"/>
            </column>
            <column name="access_expires_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="refresh_expires_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="revoked_at" type="timestamptz"/>
            <column name="remember_me" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="timestamptz" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(100)" defaultValue="sys-admin">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_date" type="timestamptz" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="last_modified_by" type="varchar(100)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="user_tokens" baseColumnNames="account_id"
                referencedTableName="user_accounts" referencedColumnNames="id"
                constraintName="fk_user_tokens_account" onDelete="CASCADE"/>
        <createIndex tableName="user_tokens" indexName="idx_user_tokens_account">
            <column name="account_id"/>
        </createIndex>
        <createIndex tableName="user_tokens" indexName="idx_user_tokens_refresh_expires_at">
            <column name="refresh_expires_at"/>
        </createIndex>

        <createTable tableName="password_reset_tokens">
            <column name="id" type="uuid">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_password_reset_tokens"/>
            </column>
            <column name="account_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="token_hash" type="varchar(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_password_reset_tokens_token_hash"/>
            </column>
            <column name="expires_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="consumed_at" type="timestamptz"/>
            <column name="created_date" type="timestamptz" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(100)" defaultValue="sys-admin">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_date" type="timestamptz" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="last_modified_by" type="varchar(100)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="password_reset_tokens" baseColumnNames="account_id"
                referencedTableName="user_accounts" referencedColumnNames="id"
                constraintName="fk_password_reset_tokens_account" onDelete="CASCADE"/>
        <createIndex tableName="password_reset_tokens" indexName="idx_password_reset_tokens_account">
            <column name="account_id"/>
        </createIndex>
        <createIndex tableName="password_reset_tokens" indexName="idx_password_reset_tokens_expires_at">
            <column name="expires_at"/>
        </createIndex>

        <rollback>
            <dropTable tableName="password_reset_tokens"/>
            <dropTable tableName="user_tokens"/>
            <dropTable tableName="user_accounts"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
