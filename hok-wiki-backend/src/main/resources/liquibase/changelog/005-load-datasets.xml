<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Initial international-server catalog curated from https://hokstats.gg/ on 2026-10-23. -->
    <changeSet id="catalog-005-load-datasets" author="dev-yahya" contextFilter="@dataset">
        <preConditions onFail="HALT" onError="HALT"
                onFailMessage="Initial datasets require empty hero, item, arcana, and spells tables.">
            <sqlCheck expectedResult="0">SELECT (SELECT count(*) FROM hero) + (SELECT count(*) FROM item) + (SELECT count(*) FROM arcana) + (SELECT count(*) FROM spells)</sqlCheck>
        </preConditions>

        <!-- SQL literals allow PostgreSQL to cast the CSV JSON strings into jsonb columns. -->
        <loadData tableName="hero" file="../dataset/hero.csv" relativeToChangelogFile="true"
                separator=";" quotchar="&quot;" encoding="UTF-8" usePreparedStatements="false">
            <column header="id" name="id" type="UUID"/>
            <column header="name" name="name" type="STRING"/>
            <column header="slug" name="slug" type="STRING"/>
            <column header="image_url" name="image_url" type="STRING"/>
            <column header="description" name="description" type="STRING"/>
            <column header="tags" name="tags" type="STRING"/>
            <column header="guide" name="guide" type="STRING"/>
        </loadData>
        <loadData tableName="item" file="../dataset/items.csv" relativeToChangelogFile="true"
                separator=";" quotchar="&quot;" encoding="UTF-8" usePreparedStatements="false">
            <column header="id" name="id" type="UUID"/>
            <column header="category" name="category" type="STRING"/>
            <column header="name" name="name" type="STRING"/>
            <column header="slug" name="slug" type="STRING"/>
            <column header="price_gold" name="price_gold" type="NUMERIC"/>
            <column header="image_url" name="image_url" type="STRING"/>
            <column header="stats" name="stats" type="STRING"/>
            <column header="passive" name="passive" type="STRING"/>
            <column header="builds_from" name="builds_from" type="STRING"/>
        </loadData>
        <loadData tableName="arcana" file="../dataset/arcana.csv" relativeToChangelogFile="true"
                separator=";" quotchar="&quot;" encoding="UTF-8" usePreparedStatements="false">
            <column header="id" name="id" type="UUID"/>
            <column header="name" name="name" type="STRING"/>
            <column header="slug" name="slug" type="STRING"/>
            <column header="stats" name="stats" type="STRING"/>
            <column header="image_url" name="image_url" type="STRING"/>
        </loadData>
        <loadData tableName="spells" file="../dataset/spells.csv" relativeToChangelogFile="true"
                separator=";" quotchar="&quot;" encoding="UTF-8" usePreparedStatements="false">
            <column header="id" name="id" type="UUID"/>
            <column header="name" name="name" type="STRING"/>
            <column header="slug" name="slug" type="STRING"/>
            <column header="description" name="description" type="STRING"/>
            <column header="image_url" name="image_url" type="STRING"/>
            <column header="usage_tip" name="usage_tip" type="STRING"/>
        </loadData>
        <loadData tableName="hero_roles" file="../dataset/hero_roles_enum.csv" relativeToChangelogFile="true"
                separator=";" quotchar="&quot;" encoding="UTF-8">
            <column header="hero_id" name="hero_id" type="UUID"/>
            <column header="role" name="role" type="STRING"/>
        </loadData>
        <loadData tableName="hero_lanes" file="../dataset/hero_lanes_enum.csv" relativeToChangelogFile="true"
                separator=";" quotchar="&quot;" encoding="UTF-8">
            <column header="hero_id" name="hero_id" type="UUID"/>
            <column header="lane" name="lane" type="STRING"/>
        </loadData>
        <!-- No automatic rollback: seeded rows may have been edited by administrators afterward. -->
    </changeSet>
</databaseChangeLog>
