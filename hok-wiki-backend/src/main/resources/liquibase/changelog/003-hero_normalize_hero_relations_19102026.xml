<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
		logicalFilePath="liquibase/changelog/hero/003-normalize-hero-relations.xml"
		xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

	<changeSet id="hero-003-normalize-role-and-lane-relations" author="dev-yahya">

		<addColumn tableName="hero_roles">
			<column name="role_id" type="uuid"/>
		</addColumn>
		<sql><![CDATA[
			INSERT INTO roles (id, name, slug)
			SELECT md5('role:' || lower(relation.role))::uuid, min(relation.role), lower(relation.role)
			FROM hero_roles relation
			WHERE NOT EXISTS (SELECT 1 FROM roles reference WHERE reference.slug = lower(relation.role))
			GROUP BY lower(relation.role);

			UPDATE hero_roles relation SET role_id = reference.id
			FROM roles reference WHERE reference.slug = lower(relation.role);
		]]></sql>
		<addNotNullConstraint tableName="hero_roles" columnName="role_id" columnDataType="uuid"/>
		<dropIndex tableName="hero_roles" indexName="idx_hero_roles_lower_role_hero"/>
		<dropPrimaryKey tableName="hero_roles" constraintName="pk_hero_roles"/>
		<dropColumn tableName="hero_roles" columnName="role"/>
		<addPrimaryKey tableName="hero_roles" columnNames="hero_id,role_id" constraintName="pk_hero_roles"/>
		<addForeignKeyConstraint baseTableName="hero_roles" baseColumnNames="role_id"
				referencedTableName="roles" referencedColumnNames="id"
				constraintName="fk_hero_roles_role"/>
		<createIndex tableName="hero_roles" indexName="idx_hero_roles_role_hero">
			<column name="role_id"/>
			<column name="hero_id"/>
		</createIndex>

		<addColumn tableName="hero_lanes">
			<column name="lane_id" type="uuid"/>
		</addColumn>
		<sql><![CDATA[
			INSERT INTO lanes (id, name, slug)
			SELECT md5('lane:' || lower(relation.lane))::uuid, min(relation.lane), lower(relation.lane)
			FROM hero_lanes relation
			WHERE NOT EXISTS (SELECT 1 FROM lanes reference WHERE reference.slug = lower(relation.lane))
			GROUP BY lower(relation.lane);

			UPDATE hero_lanes relation SET lane_id = reference.id
			FROM lanes reference WHERE reference.slug = lower(relation.lane);
		]]></sql>
		<addNotNullConstraint tableName="hero_lanes" columnName="lane_id" columnDataType="uuid"/>
		<dropIndex tableName="hero_lanes" indexName="idx_hero_lanes_lower_lane_hero"/>
		<dropPrimaryKey tableName="hero_lanes" constraintName="pk_hero_lanes"/>
		<dropColumn tableName="hero_lanes" columnName="lane"/>
		<addPrimaryKey tableName="hero_lanes" columnNames="hero_id,lane_id" constraintName="pk_hero_lanes"/>
		<addForeignKeyConstraint baseTableName="hero_lanes" baseColumnNames="lane_id"
				referencedTableName="lanes" referencedColumnNames="id"
				constraintName="fk_hero_lanes_lane"/>
		<createIndex tableName="hero_lanes" indexName="idx_hero_lanes_lane_hero">
			<column name="lane_id"/>
			<column name="hero_id"/>
		</createIndex>

		<rollback>
			<addColumn tableName="hero_lanes">
				<column name="lane" type="varchar(64)"/>
			</addColumn>
			<sql>UPDATE hero_lanes relation SET lane = reference.name FROM lanes reference WHERE reference.id = relation.lane_id</sql>
			<addNotNullConstraint tableName="hero_lanes" columnName="lane" columnDataType="varchar(64)"/>
			<dropForeignKeyConstraint baseTableName="hero_lanes" constraintName="fk_hero_lanes_lane"/>
			<dropIndex tableName="hero_lanes" indexName="idx_hero_lanes_lane_hero"/>
			<dropPrimaryKey tableName="hero_lanes" constraintName="pk_hero_lanes"/>
			<dropColumn tableName="hero_lanes" columnName="lane_id"/>
			<addPrimaryKey tableName="hero_lanes" columnNames="hero_id,lane" constraintName="pk_hero_lanes"/>
			<createIndex tableName="hero_lanes" indexName="idx_hero_lanes_lower_lane_hero">
				<column name="lower(lane)" computed="true"/>
				<column name="hero_id"/>
			</createIndex>
			<addColumn tableName="hero_roles">
				<column name="role" type="varchar(64)"/>
			</addColumn>
			<sql>UPDATE hero_roles relation SET role = reference.name FROM roles reference WHERE reference.id = relation.role_id</sql>
			<addNotNullConstraint tableName="hero_roles" columnName="role" columnDataType="varchar(64)"/>
			<dropForeignKeyConstraint baseTableName="hero_roles" constraintName="fk_hero_roles_role"/>
			<dropIndex tableName="hero_roles" indexName="idx_hero_roles_role_hero"/>
			<dropPrimaryKey tableName="hero_roles" constraintName="pk_hero_roles"/>
			<dropColumn tableName="hero_roles" columnName="role_id"/>
			<addPrimaryKey tableName="hero_roles" columnNames="hero_id,role" constraintName="pk_hero_roles"/>
			<createIndex tableName="hero_roles" indexName="idx_hero_roles_lower_role_hero">
				<column name="lower(role)" computed="true"/>
				<column name="hero_id"/>
			</createIndex>
		</rollback>
	</changeSet>
</databaseChangeLog>
