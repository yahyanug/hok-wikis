# Copy to .env in the hok-wikis/docker directory; run Compose from that directory.
# IntelliJ/bootRun uses the local defaults in application.yml without this file.
# Production JWT and Cloudflare tokens still need real environment values.

# Cloudflare Tunnel: create a remotely-managed tunnel, copy its connector token
# into .env, then publish your hostname with service URL http://frontend:3000.
# Enable Always Use HTTPS for the public hostname in Cloudflare.
# No public inbound web ports are needed on the VPS.
# DOMAIN is a reminder for dashboard setup, not an automatic DNS configuration.
DOMAIN=wiki.example.com
CLOUDFLARE_TUNNEL_TOKEN=

POSTGRES_DB=hok-wiki
POSTGRES_USER=user123
# Local testing credentials requested by the user.
# These values initialize a NEW PostgreSQL volume; they do not alter existing roles.
POSTGRES_PASSWORD=password123

# Required: Base64 of at least 64 random bytes.
# Generate one line: openssl rand -base64 64 | tr -d '\n'
# Keep the entire result on ONE line. Never replace it on every container restart.
JWT_BASE64_SECRET=
JWT_ISSUER=hok-wiki

SPRING_PROFILES_ACTIVE=prod
# No automatic catalog seed. Use prod,dataset ONLY for an empty catalog on initial setup.
LIQUIBASE_CONTEXTS=prod
BACKEND_MEMORY_LIMIT=1g
FRONTEND_MEMORY_LIMIT=512m

# Optional first admin: use SPRING_PROFILES_ACTIVE=prod,admin-bootstrap for first run.
# Email must be valid; full name 1-255 chars; password 12-72 chars and <=72 UTF-8 bytes.
# Afterwards remove admin-bootstrap from the profiles and clear these values.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_FULL_NAME=
